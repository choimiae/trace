{
  "name": "trace",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @trace/shared && npm run build --workspace @trace/sdk && npm run build --workspace @trace/api && npm run build --workspace @trace/admin",
    "pretest": "npm run build --workspace @trace/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "dev:api": "npm run dev --workspace @trace/api",
    "dev:admin": "npm run dev --workspace @trace/admin",
    "dev:demo": "vite examples/demo-site --host 0.0.0.0 --port 3000 --strictPort"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/ui": "^2.1.9",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

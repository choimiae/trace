{
  "name": "trace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "dev:api": "npm run dev --workspace @trace/api",
    "dev:admin": "npm run dev --workspace @trace/admin"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/ui": "^2.1.9",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
